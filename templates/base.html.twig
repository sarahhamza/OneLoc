    <a class="nav-link" href="{{ path('app_my_properties') }}">My Properties</a>
</li>
                                           <li><a href="{{ path('app_reservation_dashboard') }}">My Reservations</a></li>                  
                                                                     <li><a href="{{ path('app_property_new') }}">Add Listing</a></li>
                                                                                                 <li><a href="{{ path('app_profile_show') }}">Profile</a></li>
         
                                            <li><a href="{{ path('app_logout') }}">Logout</a></li>
