{# templates/admin/properties.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Properties Management{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold mb-0">
            <i class="bi bi-building text-danger me-2"></i>
            Properties Management
        </h2>
        <span class="badge bg-danger fs-6">{{ properties|length }} Total</span>
    </div>

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show">
                {{ msg }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Properties Table #}
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0 fw-bold text-dark">All Properties</h5>
                </div>
                <div class="col-auto">
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Search properties...">
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle" id="propertiesTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0">ID</th>
                            <th class="border-0">Title</th>
                            <th class="border-0">Price</th>
                            <th class="border-0">Details</th>
                            <th class="border-0">Owner</th>
                            <th class="border-0">Status</th>
                            <th class="border-0 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for property in properties %}
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark fw-bold">#{{ property.id }}</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-danger bg-opacity-10 text-danger rounded p-2 me-2">
                                            <i class="bi bi-house-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">{{ property.title|length > 35 ? property.title|slice(0,35)~'...' : property.title }}</div>
                                            <small class="text-muted">{{ property.address|length > 40 ? property.address|slice(0,40)~'...' : property.address }}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">${{ property.price|number_format(0, '.', ',') }}</span>
                                </td>
                                <td>
                                    <div class="small">
                                        <i class="bi bi-door-closed text-muted"></i> {{ property.bedrooms }} Beds
                                        <i class="bi bi-droplet text-muted ms-2"></i> {{ property.bathrooms }} Baths
                                        <i class="bi bi-arrows-angle-expand text-muted ms-2"></i> {{ property.area }} m²
                                    </div>
                                </td>
                                <td>
                                    <small class="text-muted">{{ property.owner.email }}</small>
                                </td>
                                <td>
                                    <span class="badge {{ property.available ? 'bg-success' : 'bg-secondary' }}">
                                        <i class="bi bi-{{ property.available ? 'check-circle-fill' : 'x-circle-fill' }} me-1"></i>
                                        {{ property.available ? 'Available' : 'Unavailable' }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editPropertyModal"
                                                data-id="{{ property.id }}"
                                                data-title="{{ property.title|e('html_attr') }}"
                                                data-description="{{ property.description|e('html_attr') }}"
                                                data-address="{{ property.address|e('html_attr') }}"
                                                data-price="{{ property.price }}"
                                                data-bedrooms="{{ property.bedrooms }}"
                                                data-bathrooms="{{ property.bathrooms }}"
                                                data-area="{{ property.area }}"
                                                data-available="{{ property.available ? '1' : '0' }}"
                                                data-photos="{{ property.getPhotos()|json_encode|e('html_attr') }}"
                                                data-owner-id="{{ property.owner.id }}">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form method="post" action="{{ path('admin_property_delete', {id: property.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this property?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="text-center text-muted py-5">No properties found</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# Edit Property Modal #}
<div class="modal fade" id="editPropertyModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form id="propertyForm" method="post" enctype="multipart/form-data">
            <div class="modal-content border-0 shadow">
                <div class="modal-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-pencil-square me-2"></i>Edit Property
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="propId">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Title</label>
                            <input type="text" name="title" id="propTitle" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Price</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" name="price" id="propPrice" class="form-control" required>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Description</label>
                            <textarea name="description" id="propDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Address</label>
                            <input type="text" name="address" id="propAddress" class="form-control" required>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Bedrooms</label>
                            <input type="number" name="bedrooms" id="propBedrooms" class="form-control" min="0" required>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Bathrooms</label>
                            <input type="number" name="bathrooms" id="propBathrooms" class="form-control" min="0" required>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Area (m²)</label>
                            <input type="number" name="area" id="propArea" class="form-control" min="0" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Owner</label>
                            <select name="ownerId" id="propOwner" class="form-select" required>
                                {% for user in users %}
                                    <option value="{{ user.id }}">{{ user.email }} ({{ user.firstName }} {{ user.lastName }})</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold d-block">Availability</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="available" id="propAvailable">
                                <label class="form-check-label" for="propAvailable">
                                    <i class="bi bi-check-circle me-1"></i>Available for rent
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Add Photos</label>
                            <input type="file" name="photos[]" class="form-control" multiple accept="image/*">
                            <div id="currentPhotos" class="mt-3"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save me-1"></i>Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    // Fill Property Modal
    document.getElementById('editPropertyModal').addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const modal = this;

        // Fill form
        modal.querySelector('#propId').value = button.dataset.id;
        modal.querySelector('#propTitle').value = button.dataset.title;
        modal.querySelector('#propDescription').value = button.dataset.description;
        modal.querySelector('#propAddress').value = button.dataset.address;
        modal.querySelector('#propPrice').value = button.dataset.price;
        modal.querySelector('#propBedrooms').value = button.dataset.bedrooms;
        modal.querySelector('#propBathrooms').value = button.dataset.bathrooms;
        modal.querySelector('#propArea').value = button.dataset.area;
        modal.querySelector('#propAvailable').checked = button.dataset.available === '1';
        modal.querySelector('#propOwner').value = button.dataset.ownerId;

        // Update form action
        modal.querySelector('#propertyForm').action = `/admin/property/${button.dataset.id}/edit`;

        // Show current photos
        const photos = JSON.parse(button.dataset.photos || '[]');
        const container = modal.querySelector('#currentPhotos');
        container.innerHTML = '';
        if (photos.length > 0) {
            container.innerHTML = '<small class="text-muted fw-bold">Current Photos:</small><div class="d-flex flex-wrap mt-2"></div>';
            const photoContainer = container.querySelector('div');
            photos.forEach(photo => {
                const img = document.createElement('img');
                img.src = `/uploads/properties/${photo}`;
                img.style.width = '80px';
                img.style.height = '80px';
                img.style.objectFit = 'cover';
                img.style.margin = '4px';
                img.className = 'rounded border';
                photoContainer.appendChild(img);
            });
        }
    });

    // AJAX Submit
    document.getElementById('propertyForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const data = new FormData(this);
        fetch(this.action, {
            method: 'POST',
            body: data,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(json => {
            if (json.success) {
                location.reload();
            }
        })
        .catch(() => location.reload());
    });

    // Search functionality
    document.getElementById('searchInput').addEventListener('keyup', function() {
        const filter = this.value.toLowerCase();
        const rows = document.querySelectorAll('#propertiesTable tbody tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    });
</script>
{% endblock %}
