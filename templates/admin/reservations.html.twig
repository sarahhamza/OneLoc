{# templates/admin/reservations.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Reservations Management{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold mb-0">
            <i class="bi bi-calendar-check text-danger me-2"></i>
            Reservations Management
        </h2>
        <span class="badge bg-danger fs-6">{{ reservations|length }} Total</span>
    </div>

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show">
                {{ msg }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Reservations Table #}
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0 fw-bold text-dark">All Reservations</h5>
                </div>
                <div class="col-auto">
                    <select id="filterStatus" class="form-select form-select-sm me-2" style="display: inline-block; width: auto;">
                        <option value="">All Status</option>
                        <option value="pending">Pending</option>
                        <option value="accepted">Accepted</option>
                        <option value="rejected">Rejected</option>
                    </select>
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Search..." style="display: inline-block; width: 200px;">
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle" id="reservationsTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0">ID</th>
                            <th class="border-0">Tenant</th>
                            <th class="border-0">Property</th>
                            <th class="border-0">Dates</th>
                            <th class="border-0">Status</th>
                            <th class="border-0">Created</th>
                            <th class="border-0 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for reservation in reservations %}
                            <tr data-status="{{ reservation.status }}">
                                <td>
                                    <span class="badge bg-light text-dark fw-bold">#{{ reservation.id }}</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-2 me-2">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">{{ reservation.tenant.firstName }} {{ reservation.tenant.lastName }}</div>
                                            <small class="text-muted">{{ reservation.tenant.email }}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-danger bg-opacity-10 text-danger rounded p-2 me-2">
                                            <i class="bi bi-house-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">{{ reservation.property.title|length > 30 ? reservation.property.title|slice(0,30)~'...' : reservation.property.title }}</div>
                                            <small class="text-muted">${{ reservation.property.price|number_format(0, '.', ',') }}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small">
                                        <i class="bi bi-calendar-check text-success"></i> {{ reservation.checkIn|date('M j, Y') }}
                                        <br>
                                        <i class="bi bi-calendar-x text-danger"></i> {{ reservation.checkOut|date('M j, Y') }}
                                    </div>
                                </td>
                                <td>
                                    <span class="badge {{ reservation.status == 'pending' ? 'bg-warning text-dark' : (reservation.status == 'accepted' ? 'bg-success' : 'bg-danger') }}">
                                        <i class="bi bi-{{ reservation.status == 'pending' ? 'clock-fill' : (reservation.status == 'accepted' ? 'check-circle-fill' : 'x-circle-fill') }} me-1"></i>
                                        {{ reservation.status|capitalize }}
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">{{ reservation.createdAt|date('M j, Y') }}</small>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editReservationModal"
                                                onclick="fillReservationModal({{ reservation.id }}, '{{ reservation.status }}')">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form method="post"
                                              action="{{ path('admin_reservation_delete', {id: reservation.id}) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this reservation?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="text-center text-muted py-5">No reservations found</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# Edit Reservation Modal #}
<div class="modal fade" id="editReservationModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="reservationForm" method="post">
            <div class="modal-content border-0 shadow">
                <div class="modal-header" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-pencil-square me-2"></i>Edit Reservation
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status</label>
                        <select name="status" class="form-select" required>
                            <option value="pending">
                                <i class="bi bi-clock-fill"></i> Pending
                            </option>
                            <option value="accepted">
                                <i class="bi bi-check-circle-fill"></i> Accepted
                            </option>
                            <option value="rejected">
                                <i class="bi bi-x-circle-fill"></i> Rejected
                            </option>
                        </select>
                        <div class="form-text">Update the status of this reservation</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-warning text-dark">
                        <i class="bi bi-save me-1"></i>Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    // Fill Reservation Modal
    function fillReservationModal(id, status) {
        const form = document.getElementById('reservationForm');
        form.action = `/admin/reservation/${id}/edit`;
        form.querySelector('[name="status"]').value = status;
    }

    // Search functionality
    document.getElementById('searchInput').addEventListener('keyup', function() {
        filterTable();
    });

    // Filter by status
    document.getElementById('filterStatus').addEventListener('change', function() {
        filterTable();
    });

    function filterTable() {
        const searchFilter = document.getElementById('searchInput').value.toLowerCase();
        const statusFilter = document.getElementById('filterStatus').value.toLowerCase();
        const rows = document.querySelectorAll('#reservationsTable tbody tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            const status = row.dataset.status || '';
            
            const matchesSearch = text.includes(searchFilter);
            const matchesStatus = !statusFilter || status === statusFilter;
            
            row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
        });
    }
</script>
{% endblock %}
