{# templates/admin/dashboard.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show">
                {{ msg }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# ---------- STATS ---------- #}
    <div class="row g-3 mb-5">
        <div class="col-6 col-md-3">
            <div class="card bg-primary text-white border-0 shadow-sm">
                <div class="card-body d-flex align-items-center p-3">
                    <i class="bi bi-people fs-2 me-3"></i>
                    <div><h4 class="mb-0">{{ stats.users }}</h4><small>Users</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-success text-white border-0 shadow-sm">
                <div class="card-body d-flex align-items-center p-3">
                    <i class="bi bi-building fs-2 me-3"></i>
                    <div><h4 class="mb-0">{{ stats.properties }}</h4><small>Properties</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-warning text-white border-0 shadow-sm">
                <div class="card-body d-flex align-items-center p-3">
                    <i class="bi bi-calendar-check fs-2 me-3"></i>
                    <div><h4 class="mb-0">{{ stats.reservations }}</h4><small>Reservations</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-danger text-white border-0 shadow-sm">
                <div class="card-body d-flex align-items-center p-3">
                    <i class="bi bi-hourglass-split fs-2 me-3"></i>
                    <div><h4 class="mb-0">{{ stats.pending }}</h4><small>Pending</small></div>
                </div>
            </div>
        </div>
    </div>

    {# ---------- USERS ---------- #}
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-people me-2"></i> Users ({{ users|length }})</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Verified</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for u in users %}
                            <tr data-id="{{ u.id }}">
                                <td>{{ u.id }}</td>
                                <td>{{ u.firstName }} {{ u.lastName }}</td>
                                <td>{{ u.email }}</td>
                                <td>{{ u.phone|default('-') }}</td>
                                <td>
                                    <span class="badge bg-{{ u.verified ? 'success' : 'secondary' }}">{{ u.verified ? 'Yes' : 'No' }}</span>
                                </td>
                                <td>
                                    <span class="badge bg-{{ 'ROLE_ADMIN' in u.getRoles() ? 'danger' : 'secondary' }}">
                                        {{ 'ROLE_ADMIN' in u.getRoles() ? 'Admin' : 'User' }}
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editUserModal"
                                            onclick="fillUserModal({{ u.id }}, '{{ u.firstName }}', '{{ u.lastName }}', '{{ u.email }}', '{{ u.phone|default('') }}', {{ u.verified ? 'true' : 'false' }})">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post"
                                          action="{{ path('admin_user_delete', {id: u.id}) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this user?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="text-center text-muted py-4">No users</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# ---------- PROPERTIES ---------- #}
{# ---------- PROPERTIES ---------- #}
<div class="card shadow-sm mb-5">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Properties ({{ properties|length }})</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Price</th>
                        <th>Beds</th>
                        <th>Baths</th>
                        <th>Area</th>
                        <th>Available</th>
                        <th>Owner</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
{% for p in properties %}
    <tr>
        <td>{{ p.id }}</td>
        <td>{{ p.title|length > 30 ? p.title|slice(0,30)~'...' : p.title }}</td>
        <td>${{ p.price }}</td>
        <td>{{ p.bedrooms }}</td>
        <td>{{ p.bathrooms }}</td>
        <td>{{ p.area }} m²</td>
        <td>
            <span class="badge bg-{{ p.available ? 'success' : 'secondary' }}">
                {{ p.available ? 'Yes' : 'No' }}
            </span>
        </td>
        <td>{{ p.owner.email }}</td>
        <td>
            <button type="button"
                    class="btn btn-sm btn-outline-primary me-1"
                    data-bs-toggle="modal"
                    data-bs-target="#editPropertyModal"
                    data-id="{{ p.id }}"
                    data-title="{{ p.title|e('html_attr') }}"
                    data-description="{{ p.description|e('html_attr') }}"
                    data-address="{{ p.address|e('html_attr') }}"
                    data-price="{{ p.price }}"
                    data-bedrooms="{{ p.bedrooms }}"
                    data-bathrooms="{{ p.bathrooms }}"
                    data-area="{{ p.area }}"
                    data-available="{{ p.available ? '1' : '0' }}"
                    data-photos="{{ p.getPhotos()|json_encode|e('html_attr') }}"
                    data-owner-id="{{ p.owner.id }}">
                Edit
            </button>
            <form method="post" action="{{ path('admin_property_delete', {id: p.id}) }}" class="d-inline" onsubmit="return confirm('Delete?')">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        </td>
    </tr>
{% else %}
    <tr><td colspan="9" class="text-center text-muted py-4">No properties</td></tr>
{% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# ---- PROPERTY MODAL ---- #}
<!-- PROPERTY MODAL -->
<div class="modal fade" id="editPropertyModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form id="propertyForm" method="post" enctype="multipart/form-data">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Edit Property</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="propId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label>Title</label>
                            <input type="text" name="title" id="propTitle" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label>Price</label>
                            <input type="number" step="0.01" name="price" id="propPrice" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <label>Description</label>
                            <textarea name="description" id="propDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label>Address</label>
                            <input type="text" name="address" id="propAddress" class="form-control" required>
                        </div>
                        <div class="col-md-2">
                            <label>Bedrooms</label>
                            <input type="number" name="bedrooms" id="propBedrooms" class="form-control" min="0" required>
                        </div>
                        <div class="col-md-2">
                            <label>Bathrooms</label>
                            <input type="number" name="bathrooms" id="propBathrooms" class="form-control" min="0" required>
                        </div>
                        <div class="col-md-2">
                            <label>Area (m²)</label>
                            <input type="number" name="area" id="propArea" class="form-control" min="0" required>
                        </div>
                        <div class="col-md-6">
                            <label>Owner</label>
                            <select name="owner" id="propOwner" class="form-select" required>
                                {% for user in users %}
                                    <option value="{{ user.id }}">{{ user.email }} ({{ user.firstName }} {{ user.lastName }})</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Available</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="available" id="propAvailable">
                            </div>
                        </div>
                        <div class="col-12">
                            <label>Add Photos</label>
                            <input type="file" name="photos[]" class="form-control" multiple accept="image/*">
                            <div id="currentPhotos" class="mt-2"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </div>
        </form>
    </div>
</div>

    {# ---------- RESERVATIONS ---------- #}
    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i> Reservations ({{ reservations|length }})</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Tenant</th>
                            <th>Property</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in reservations %}
                            <tr data-id="{{ r.id }}">
                                <td>{{ r.id }}</td>
                                <td>{{ r.tenant.email }}</td>
                                <td>{{ r.property.title }}</td>
                                <td>{{ r.checkIn|date('M j, Y') }}</td>
                                <td>{{ r.checkOut|date('M j, Y') }}</td>
                                <td>
                                    <span class="badge bg-{{ r.status == 'pending' ? 'warning' : (r.status == 'accepted' ? 'success' : 'danger') }}">
                                        {{ r.status|capitalize }}
                                    </span>
                                </td>
                                <td>{{ r.createdAt|date('M j, Y') }}</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editReservationModal"
                                            onclick="fillReservationModal({{ r.id }}, '{{ r.status }}')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post"
                                          action="{{ path('admin_reservation_delete', {id: r.id}) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this reservation?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="8" class="text-center text-muted py-4">No reservations</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# ==================== MODALS ==================== #}

{# ---- USER ---- #}
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="userForm" method="post">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Edit User</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="_method" value="POST">
                    <div class="mb-3">
                        <label class="form-label">First Name</label>
                        <input type="text" name="firstName" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Last Name</label>
                        <input type="text" name="lastName" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="phone" class="form-control">
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="verified" id="userVerified">
                        <label class="form-check-label" for="userVerified">Verified</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>



{# ---- RESERVATION ---- #}
<div class="modal fade" id="editReservationModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="reservationForm" method="post">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">Edit Reservation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="_method" value="POST">
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="pending">Pending</option>
                            <option value="accepted">Accepted</option>
                            <option value="rejected">Rejected</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    // ---------- USER ----------
    function fillUserModal(id, first, last, email, phone, verified) {
        const form = document.getElementById('userForm');
        form.action = `/admin/user/${id}/edit`;
        form.querySelector('[name="firstName"]').value = first;
        form.querySelector('[name="lastName"]').value = last;
        form.querySelector('[name="email"]').value = email;
        form.querySelector('[name="phone"]').value = phone;
        form.querySelector('#userVerified').checked = verified;
    }

    // ---------- PROPERTY ----------
document.getElementById('editPropertyModal').addEventListener('show.bs.modal', function (event) {
    const button = event.relatedTarget;
    const modal = this;

    // Fill form
    modal.querySelector('#propId').value = button.dataset.id;
    modal.querySelector('#propTitle').value = button.dataset.title;
    modal.querySelector('#propDescription').value = button.dataset.description;
    modal.querySelector('#propAddress').value = button.dataset.address;
    modal.querySelector('#propPrice').value = button.dataset.price;
    modal.querySelector('#propBedrooms').value = button.dataset.bedrooms;
    modal.querySelector('#propBathrooms').value = button.dataset.bathrooms;
    modal.querySelector('#propArea').value = button.dataset.area;
    modal.querySelector('#propAvailable').checked = button.dataset.available === '1';
    modal.querySelector('#propOwner').value = button.dataset.ownerId;

    // Update form action
    modal.querySelector('#propertyForm').action = `/admin/property/${button.dataset.id}/edit`;

    // Show current photos
    const photos = JSON.parse(button.dataset.photos || '[]');
    const container = modal.querySelector('#currentPhotos');
    container.innerHTML = '';
    photos.forEach(photo => {
        const img = document.createElement('img');
        img.src = `/uploads/properties/${photo}`;
        img.style.width = '80px';
        img.style.height = '80px';
        img.style.objectFit = 'cover';
        img.style.margin = '4px';
        img.className = 'rounded border';
        container.appendChild(img);
    });
});

// Submit with AJAX
document.getElementById('propertyForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const data = new FormData(this);
    fetch(this.action, {
        method: 'POST',
        body: data,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(json => {
        if (json.success) {
            location.reload();
        }
    })
    .catch(() => location.reload());
});

    // ---------- RESERVATION ----------
    function fillReservationModal(id, status) {
        const form = document.getElementById('reservationForm');
        form.action = `/admin/reservation/${id}/edit`;
        form.querySelector('[name="status"]').value = status;
    }

    // ---------- AJAX SUBMIT (optional – fallback to full page reload) ----------
    document.querySelectorAll('#userForm, #propertyForm, #reservationForm').forEach(f => {
        f.addEventListener('submit', function (e) {
            e.preventDefault();
            const data = new FormData(this);
            fetch(this.action, {
                method: 'POST',
                body: data,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(json => {
                if (json.success) {
                    location.reload();   // simple reload – you can update rows without reload if you want
                }
            })
            .catch(() => location.reload());
        });
    });
</script>
{% endblock %}