{# templates/reservation/new.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Reserve {{ property.title }}{% endblock %}

{% block body %}
<div class="breadcumb-wrapper" data-bg-src="{{ asset('assets/img/blog/breadcrumb-bg.jpg') }}">
    <div class="container">
        <div class="breadcumb-content">
            <h1 class="breadcumb-title">Reserve Property</h1>
            <ul class="breadcumb-menu">
                <li><a href="{{ path('app_home') }}">Home</a></li>
                <li><a href="{{ path('app_property_show', {slug: property.slug}) }}">{{ property.title }}</a></li>
                <li>Reserve</li>
            </ul>
        </div>
    </div>
</div>

<section class="space">
    <div class="container">
        <h2 class="mb-4">{{ property.title }}</h2>
        {{ form_start(form) }}
            <div class="row gy-3">
                <div class="col-md-6">{{ form_row(form.fullName) }}</div>
                <div class="col-md-6">{{ form_row(form.email) }}</div>
                <div class="col-md-6">{{ form_row(form.phone) }}</div>
                <div class="col-md-6">{{ form_row(form.preferredDate) }}</div>
                <div class="col-12">{{ form_row(form.message) }}</div>
                <div class="col-12 text-center">
                    <button class="th-btn">Send Reservation</button>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</section>
{% endblock %}