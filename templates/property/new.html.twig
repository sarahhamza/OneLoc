{# templates/property/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Add Property - OneLoc Real Estate{% endblock %}

{% block body %}
<!-- Hero Section with Background Video -->
<div class="position-relative vh-100 d-flex align-items-center">
    <!-- Background Video -->
    <div class="position-absolute top-0 start-0 w-100 h-100" style="z-index: 0;">
        <video autoplay muted loop class="w-100 h-100" style="object-fit: cover;">
            <source src="/assets/img/hero/hero-2-video.mp4" type="video/mp4">
        </video>
        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(255, 65, 54, 0.9) 0%, rgba(0, 0, 0, 0.8) 100%); z-index: 1;"></div>
    </div>
    
    <!-- Hero Content -->
    <div class="container position-relative" style="z-index: 2;">
        <div class="row justify-content-center text-center text-white">
            <div class="col-lg-8">
                <h1 class="display-3 fw-bold mb-4">Sell Your Property with Confidence</h1>
                <p class="lead mb-4 fs-4">Join thousands of successful sellers on OneLoc Real Estate. List your property and reach premium buyers worldwide.</p>
                <div class="d-flex justify-content-center gap-3 mb-5">
                    <div class="text-center">
                        <div class="fs-2 fw-bold">10K+</div>
                        <div class="text-white-50">Properties Sold</div>
                    </div>
                    <div class="text-center">
                        <div class="fs-2 fw-bold">$2B+</div>
                        <div class="text-white-50">In Transactions</div>
                    </div>
                    <div class="text-center">
                        <div class="fs-2 fw-bold">98%</div>
                        <div class="text-white-50">Seller Satisfaction</div>
                    </div>
                </div>
                <a href="#property-form" class="btn btn-light btn-lg px-5 py-3 rounded-pill fw-bold fs-5" style="color: #FF4136;">
                    Start Listing Now
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="ms-2">
                        <path d="M16.172 11l-5.364-5.364 1.414-1.414L20 12l-7.778 7.778-1.414-1.414L16.172 13H4v-2z"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-4" style="z-index: 2;">
        <div class="text-white text-center">
            <small class="d-block mb-2">Scroll to Continue</small>
            <div class="bounce-animation">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Main Form Section -->
<div class="bg-light py-5" id="property-form">
    <div class="container-fluid px-4">
        <div class="row justify-content-center">
            <div class="col-12">
                <!-- Progress Header -->
                <div class="text-center mb-5 pt-4">
                    <h2 class="display-5 fw-bold text-dark mb-3">List Your Property</h2>
                    <p class="lead text-muted fs-4">Complete the form below to get your property in front of qualified buyers</p>
                    
                    <!-- Progress Steps -->
                    <div class="row justify-content-center mb-5">
                        <div class="col-lg-8">
                            <div class="d-flex justify-content-between align-items-center position-relative">
                                <!-- Progress Line -->
                                <div class="position-absolute top-50 start-0 end-0" style="height: 4px; background: #e9ecef; z-index: 1;"></div>
                                <div class="position-absolute top-50 start-0" style="height: 4px; background: #FF4136; z-index: 2; width: 25%;" id="progress-line"></div>
                                
                                <!-- Steps -->
                                {% set steps = ['Basic Info', 'Location', 'Details', 'Media'] %}
                                {% for step in steps %}
                                <div class="text-center position-relative" style="z-index: 3;">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2 step-indicator {% if loop.first %}active{% endif %}" 
                                         data-step="{{ loop.index }}" 
                                         style="width: 60px; height: 60px; background: {% if loop.first %}#FF4136{% else %}#e9ecef{% endif %}; color: {% if loop.first %}white{% else %}#6c757d{% endif %};">
                                        <span class="fw-bold fs-5">{{ loop.index }}</span>
                                    </div>
                                    <div class="fw-semibold text-dark small">{{ step }}</div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Multi-step Form -->
                <div class="row justify-content-center">
                    <div class="col-xl-10">
                        <form method="post" enctype="multipart/form-data" id="propertyForm" class="multi-step-form">
                            
                            <!-- Step 1: Basic Information -->
                            <div class="form-step active" data-step="1">
                                <div class="card shadow-lg border-0 mb-4">
                                    <div class="card-header py-4" style="background: linear-gradient(135deg, #FF4136 0%, #d63028 100%);">
                                        <div class="d-flex align-items-center text-white">
                                            <div class="bg-white rounded-circle p-3 me-4">
                                                <svg width="28" height="28" viewBox="0 0 24 24" fill="#FF4136">
                                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <h3 class="mb-1 fw-bold">Basic Information</h3>
                                                <p class="mb-0 opacity-90">Tell us about your property</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body p-5">
                                        <div class="row g-4">
                                            <div class="col-md-12">
                                                <label class="form-label fw-semibold fs-5 text-dark">Property Title <span class="text-danger">*</span></label>
                                                <input type="text" name="title" class="form-control form-control-lg border-2 bg-white rounded-3 py-3 px-4" 
                                                       placeholder="e.g. Stunning 4-Bedroom Villa with Ocean View in Sidi Bou Said" required>
                                                <div class="mt-2">
                                                    <small class="text-muted">💡 <strong>Pro Tip:</strong> Include location, key features, and unique selling points</small>
                                                </div>
                                            </div>

                                            <div class="col-md-12">
                                                <label class="form-label fw-semibold fs-5 text-dark">Property Description</label>
                                                <textarea name="description" class="form-control border-2 bg-white rounded-3 p-4" rows="6" 
                                                          placeholder="Describe your property's unique features, recent renovations, neighborhood amenities, and what makes it special..."></textarea>
                                                <div class="d-flex justify-content-between mt-3">
                                                    <small class="text-muted">Highlight key features like modern kitchen, garden, parking, security, etc.</small>
                                                    <small class="text-muted"><span id="char-count">0</span>/1000 characters</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Step 2: Location Details -->
                            <div class="form-step" data-step="2">
                                <div class="card shadow-lg border-0 mb-4">
                                    <div class="card-header py-4" style="background: linear-gradient(135deg, #FF4136 0%, #d63028 100%);">
                                        <div class="d-flex align-items-center text-white">
                                            <div class="bg-white rounded-circle p-3 me-4">
                                                <svg width="28" height="28" viewBox="0 0 24 24" fill="#FF4136">
                                                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <h3 class="mb-1 fw-bold">Location Details</h3>
                                                <p class="mb-0 opacity-90">Where is your property located?</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body p-5">
                                        <div class="row g-4">
                                            <div class="col-md-12">
                                                <label class="form-label fw-semibold fs-5 text-dark">Full Address <span class="text-danger">*</span></label>
                                                <input type="text" name="address" class="form-control form-control-lg border-2 bg-white rounded-3 py-3 px-4" 
                                                       placeholder="Enter complete address including street, city, postal code, and country" required>
                                                <div class="mt-3 p-3 bg-light rounded-3">
                                                    <small class="text-muted">📍 <strong>Location Matters:</strong> Accurate addresses help buyers find your property and improve search visibility</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Step 3: Property Specifications -->
                            <div class="form-step" data-step="3">
                                <div class="card shadow-lg border-0 mb-4">
                                    <div class="card-header py-4" style="background: linear-gradient(135deg, #FF4136 0%, #d63028 100%);">
                                        <div class="d-flex align-items-center text-white">
                                            <div class="bg-white rounded-circle p-3 me-4">
                                                <svg width="28" height="28" viewBox="0 0 24 24" fill="#FF4136">
                                                    <path d="M3 3v18h18V3H3zm8 16H5v-6h6v6zm0-8H5V5h6v6zm8 8h-6v-6h6v6zm0-8h-6V5h6v6z"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <h3 class="mb-1 fw-bold">Property Specifications</h3>
                                                <p class="mb-0 opacity-90">Details that matter to buyers</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body p-5">
                                        <div class="row g-4">
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold fs-5 text-dark">Price ($) <span class="text-danger">*</span></label>
                                                <div class="input-group input-group-lg">
                                                    <span class="input-group-text border-2 bg-white rounded-start-3 fs-5">$</span>
                                                    <input type="number" step="0.01" name="price" class="form-control border-2 bg-white rounded-end-3 py-3 px-4" 
                                                           placeholder="0.00" required>
                                                </div>
                                                <small class="text-muted mt-2 d-block">💰 <strong>Pricing Strategy:</strong> Competitive pricing attracts more views and serious offers</small>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label fw-semibold fs-5 text-dark">
                                                    🛏️ Bedrooms <span class="text-danger">*</span>
                                                </label>
                                                <input type="number" name="bedrooms" class="form-control form-control-lg border-2 bg-white rounded-3 py-3 px-4" min="0" required>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label fw-semibold fs-5 text-dark">
                                                    🛁 Bathrooms <span class="text-danger">*</span>
                                                </label>
                                                <input type="number" name="bathrooms" class="form-control form-control-lg border-2 bg-white rounded-3 py-3 px-4" min="0" required>
                                            </div>

                                            <div class="col-md-2">
                                                <label class="form-label fw-semibold fs-5 text-dark">
                                                    📐 Area (sqft) <span class="text-danger">*</span>
                                                </label>
                                                <input type="number" name="area" class="form-control form-control-lg border-2 bg-white rounded-3 py-3 px-4" min="0" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Step 4: Media Upload -->
                            <div class="form-step" data-step="4">
                                <div class="card shadow-lg border-0 mb-4">
                                    <div class="card-header py-4" style="background: linear-gradient(135deg, #FF4136 0%, #d63028 100%);">
                                        <div class="d-flex align-items-center text-white">
                                            <div class="bg-white rounded-circle p-3 me-4">
                                                <svg width="28" height="28" viewBox="0 0 24 24" fill="#FF4136">
                                                    <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <h3 class="mb-1 fw-bold">Property Photos</h3>
                                                <p class="mb-0 opacity-90">Showcase your property with high-quality images</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body p-5">
                                        <div class="row g-4">
                                            <div class="col-12">
                                                <label class="form-label fw-semibold fs-5 text-dark">Upload Property Photos</label>
                                                
                                                <!-- Drag & Drop Zone -->
                                                <div class="border-dashed rounded-4 bg-white border-3 p-5 text-center mb-4" id="dropZone">
                                                    <input type="file" name="photos[]" class="form-control d-none" multiple accept="image/*" id="photoUpload">
                                                    <div class="mb-4">
                                                        <svg width="80" height="80" viewBox="0 0 24 24" fill="#FF4136" class="opacity-75">
                                                            <path d="M4 16L8.586 11.414C8.961 11.039 9.47 10.828 10 10.828C10.53 10.828 11.039 11.039 11.414 11.414L16 16M14 14L15.586 12.414C15.961 12.039 16.47 11.828 17 11.828C17.53 11.828 18.039 12.039 18.414 12.414L20 14M14 8H14.01M6 20H18C19.1046 20 20 19.1046 20 18V6C20 4.89543 19.1046 4 18 4H6C4.89543 4 4 4.89543 4 6V18C4 19.1046 4.89543 20 6 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                        </svg>
                                                    </div>
                                                    <h4 class="fw-bold text-dark mb-3">Drag & Drop Your Photos Here</h4>
                                                    <p class="text-muted fs-6 mb-4">or click to browse your files</p>
                                                    <button type="button" class="btn btn-outline-dark btn-lg rounded-pill px-5 py-3 fw-semibold" onclick="document.getElementById('photoUpload').click()">
                                                        Select Files
                                                    </button>
                                                    <div class="mt-4">
                                                        <small class="text-muted">📸 <strong>Best Practices:</strong> Upload high-quality images (min. 1920x1080), include exterior, interior, kitchen, bathrooms, and unique features. Maximum 20 files.</small>
                                                    </div>
                                                </div>
                                                
                                                <!-- File List Preview -->
                                                <div id="fileList" class="row g-3"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Navigation Buttons -->
                            <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                                <button type="button" class="btn btn-outline-dark btn-lg px-5 py-3 rounded-pill fw-semibold fs-5" id="prev-btn" style="display: none;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="me-2">
                                        <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    Previous
                                </button>
                                
                                <button type="button" class="btn btn-lg px-5 py-3 rounded-pill fw-bold fs-5 ms-auto text-white" id="next-btn"
                                        style="background: linear-gradient(135deg, #FF4136 0%, #d63028 100%); border: none;">
                                    Continue
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="ms-2">
                                        <path d="M5 12h14M12 5l7 7-7 7"/>
                                    </svg>
                                </button>
                                
                                <button type="submit" class="btn btn-lg px-5 py-3 rounded-pill fw-bold fs-5 text-white" id="submit-btn" style="display: none; background: linear-gradient(135deg, #FF4136 0%, #d63028 100%); border: none;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                                        <path d="M5 12l5 5 10-10"/>
                                    </svg>
                                    Publish Property
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Stats Section -->
<div class="py-5 bg-white">
    <div class="container-fluid px-4">
        <div class="row justify-content-center text-center">
            <div class="col-lg-10">
                <h3 class="display-6 fw-bold text-dark mb-5">Why List With OneLoc Real Estate?</h3>
                <div class="row g-4">
                    <div class="col-md-3">
                        <div class="p-4">
                            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="#FF4136">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                                </svg>
                            </div>
                            <h5 class="fw-bold">Premium Exposure</h5>
                            <p class="text-muted">Reach millions of qualified buyers across our network</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-4">
                            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="#FF4136">
                                    <path d="M23 12l-2.44-2.78.34-3.68-3.61-.82-1.89-3.18L12 3 8.6 1.54 6.71 4.72l-3.61.81.34 3.68L1 12l2.44 2.78-.34 3.69 3.61.82 1.89 3.18L12 21l3.4 1.46 1.89-3.18 3.61-.82-.34-3.68L23 12zm-10 5h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                                </svg>
                            </div>
                            <h5 class="fw-bold">Expert Support</h5>
                            <p class="text-muted">Get guidance from our real estate specialists</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-4">
                            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="#FF4136">
                                    <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
                                </svg>
                            </div>
                            <h5 class="fw-bold">Fast Results</h5>
                            <p class="text-muted">Average listing sells 30% faster than market</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-4">
                            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="#FF4136">
                                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                </svg>
                            </div>
                            <h5 class="fw-bold">Trusted Brand</h5>
                            <p class="text-muted">15+ years of excellence in real estate</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bounce-animation {
        animation: bounce 2s infinite;
    }
    
    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% {transform: translateY(0);}
        40% {transform: translateY(-10px);}
        60% {transform: translateY(-5px);}
    }
    
    .border-dashed {
        border: 3px dashed #dee2e6 !important;
        transition: all 0.3s ease;
    }
    
    .border-dashed:hover, .border-dashed.dragover {
        border-color: #FF4136 !important;
        background-color: rgba(255, 65, 54, 0.02) !important;
        transform: scale(1.01);
    }
    
    .form-step {
        display: none;
    }
    
    .form-step.active {
        display: block;
        animation: fadeIn 0.5s ease-in;
    }
    
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .step-indicator {
        transition: all 0.3s ease;
        border: 3px solid transparent;
    }
    
    .step-indicator.active {
        background: #FF4136 !important;
        color: white !important;
        border-color: rgba(255, 65, 54, 0.3);
        transform: scale(1.1);
    }
    
    .step-indicator.completed {
        background: #28a745 !important;
        color: white !important;
    }
    
    .form-control:focus {
        box-shadow: 0 0 0 0.3rem rgba(255, 65, 54, 0.25);
        border-color: #FF4136;
    }
    
    .card {
        border: none;
        border-radius: 1.5rem;
    }
    
    .card-header {
        border-radius: 1.5rem 1.5rem 0 0 !important;
    }
    
    .file-preview {
        position: relative;
        border-radius: 1rem;
        overflow: hidden;
    }
    
    .file-preview img {
        width: 100%;
        height: 120px;
        object-fit: cover;
    }
    
    .file-remove {
        position: absolute;
        top: 5px;
        right: 5px;
        background: rgba(255, 65, 54, 0.9);
        color: white;
        border: none;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }
</style>

<script>
    // Multi-step form functionality
    let currentStep = 1;
    const totalSteps = 4;
    
    function updateProgress() {
        // Update progress line
        const progressPercentage = ((currentStep - 1) / (totalSteps - 1)) * 100;
        document.getElementById('progress-line').style.width = `${progressPercentage}%`;
        
        // Update step indicators
        document.querySelectorAll('.step-indicator').forEach((indicator, index) => {
            const stepNumber = index + 1;
            if (stepNumber < currentStep) {
                indicator.classList.add('completed');
                indicator.classList.remove('active');
                indicator.innerHTML = '✓';
                indicator.style.background = '#28a745';
            } else if (stepNumber === currentStep) {
                indicator.classList.add('active');
                indicator.classList.remove('completed');
                indicator.innerHTML = stepNumber;
                indicator.style.background = '#FF4136';
            } else {
                indicator.classList.remove('active', 'completed');
                indicator.innerHTML = stepNumber;
                indicator.style.background = '#e9ecef';
            }
        });
        
        // Update navigation buttons
        document.getElementById('prev-btn').style.display = currentStep > 1 ? 'block' : 'none';
        document.getElementById('next-btn').style.display = currentStep < totalSteps ? 'block' : 'none';
        document.getElementById('submit-btn').style.display = currentStep === totalSteps ? 'block' : 'none';
        
        // Update next button text
        if (currentStep === totalSteps - 1) {
            document.getElementById('next-btn').innerHTML = 'Continue <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="ms-2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
        } else if (currentStep === totalSteps) {
            document.getElementById('next-btn').style.display = 'none';
        }
    }
    
    function showStep(step) {
        document.querySelectorAll('.form-step').forEach(formStep => {
            formStep.classList.remove('active');
        });
        document.querySelector(`.form-step[data-step="${step}"]`).classList.add('active');
        currentStep = step;
        updateProgress();
        
        // Scroll to top of form
        document.getElementById('property-form').scrollIntoView({ behavior: 'smooth' });
    }
    
    // Event listeners
    document.getElementById('next-btn').addEventListener('click', () => {
        if (currentStep < totalSteps) {
            showStep(currentStep + 1);
        }
    });
    
    document.getElementById('prev-btn').addEventListener('click', () => {
        if (currentStep > 1) {
            showStep(currentStep - 1);
        }
    });
    
    // Character counter for description
    const textarea = document.querySelector('textarea[name="description"]');
    const charCounter = document.getElementById('char-count');
    
    if (textarea && charCounter) {
        textarea.addEventListener('input', function() {
            const count = this.value.length;
            charCounter.textContent = count;
            
            if (count > 900) {
                charCounter.style.color = '#FF4136';
            } else {
                charCounter.style.color = '#6c757d';
            }
        });
    }
    
    // File upload functionality
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('photoUpload');
    const fileList = document.getElementById('fileList');
    
    // Drag and drop functionality
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, preventDefaults, false);
    });
    
    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }
    
    ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, () => dropZone.classList.add('dragover'), false);
    });
    
    ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, () => dropZone.classList.remove('dragover'), false);
    });
    
    dropZone.addEventListener('drop', handleDrop, false);
    
    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        handleFiles(files);
    }
    
    fileInput.addEventListener('change', function() {
        handleFiles(this.files);
    });
    
    function handleFiles(files) {
        fileList.innerHTML = '';
        
        if (files.length > 0) {
            const fileCount = document.createElement('div');
            fileCount.className = 'col-12 mb-3';
            fileCount.innerHTML = `
                <div class="alert alert-light border-0 rounded-3 p-3">
                    <strong>${files.length}</strong> file(s) selected for upload. 
                    <span class="text-muted">You can select more files or drag and drop additional images.</span>
                </div>
            `;
            fileList.appendChild(fileCount);
            
            // Create preview for first few images
            Array.from(files).slice(0, 6).forEach((file, index) => {
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const col = document.createElement('div');
                        col.className = 'col-md-4 col-lg-2';
                        col.innerHTML = `
                            <div class="file-preview bg-light">
                                <img src="${e.target.result}" alt="Preview ${index + 1}">
                                <button type="button" class="file-remove" onclick="this.parentElement.parentElement.remove()">
                                    ×
                                </button>
                            </div>
                        `;
                        fileList.appendChild(col);
                    };
                    reader.readAsDataURL(file);
                }
            });
            
            if (files.length > 6) {
                const moreFiles = document.createElement('div');
                moreFiles.className = 'col-12 mt-2';
                moreFiles.innerHTML = `
                    <div class="text-center text-muted">
                        +${files.length - 6} more images selected
                    </div>
                `;
                fileList.appendChild(moreFiles);
            }
        }
    }
    
    // Initialize first step
    updateProgress();
    
    // Smooth scroll for the hero button
    document.querySelector('a[href="#property-form"]').addEventListener('click', function(e) {
        e.preventDefault();
        document.getElementById('property-form').scrollIntoView({ behavior: 'smooth' });
    });
</script>
{% endblock %}