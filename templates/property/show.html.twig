{# templates/property/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ property.title }} - OneLoc Real Estate{% endblock %}

{% block body %}


    <section class="property-details space overflow-hidden">
    
        <div class="container">
        {% if is_owner %}
        <div class="alert alert-info border-0 shadow-sm mb-4">
            <div class="d-flex align-items-center">
                <i class="fas fa-crown text-warning me-3 fs-4"></i>
                <div>
                    <strong>This is your property.</strong> You cannot make a reservation.
                    <a href="{{ path('app_my_properties') }}" class="alert-link ms-2">Manage your listings</a>
                </div>
            </div>
        </div>
    {% endif %}
            <div class="row gy-40 gx-50">

                <!-- ==================== LEFT COLUMN ==================== -->
                <div class="col-xxl-8 col-lg-7">
                    <div class="row gy-30">

<!-- Simple Image Slider -->
<div class="slider-area property-slider1">
    <div class="swiper th-slider mb-4" id="property-main-slider"
         data-slider-options='{
             "effect": "fade",
             "loop": true,
             "autoplay": { "delay": 4000 },
             "navigation": {
                 "nextEl": ".slider-next",
                 "prevEl": ".slider-prev"
             }
         }'>
        <div class="swiper-wrapper">
            {% if property.photos|length > 0 %}
                {% for photo in property.photos %}
                    <div class="swiper-slide">
                        <img src="{{ asset('uploads/properties/' ~ photo) }}" 
                             alt="{{ property.title }}" 
                             class="img-fluid w-100" 
                             style="height: 500px; object-fit: cover;">
                    </div>
                {% endfor %}
            {% else %}
                <div class="swiper-slide">
                    <img src="{{ asset('assets/img/placeholder.jpg') }}" 
                         alt="No photo" 
                         class="img-fluid w-100" 
                         style="height: 500px; object-fit: cover;">
                </div>
            {% endif %}
        </div>

        <!-- Navigation Arrows -->
        <button class="slider-arrow slider-prev">Previous</button>
        <button class="slider-arrow slider-next">Next</button>
    </div>
</div>

                        <!-- Content -->
                        <div class="property-page-single">
                            <div class="page-content">
                                <div class="property-meta-wrap mb-55 fadeinup wow">
                                    <div class="property-meta">
                                        {# <a href="#"><i class="fa-solid fa-calendar-days"></i> {{ property.createdAt|date('d M, Y') }}</a> #}
                                    </div>
                                </div>

                                <div class="page-title-wrap fadeinup wow">
                                    <h2 class="page-title mb-2">{{ property.title }}</h2>
                                    <h4 class="page-title">${{ property.price|number_format(2) }}</h4>
                                </div>

                                <div class="page-features fadeinup wow">
                                    <div class="box-text">
                                        <div class="icon"><img src="{{ asset('assets/img/icon/popular-location.svg') }}" alt="icon"></div>
                                        {{ property.address }}
                                    </div>
                                    <ul class="property-featured">
                                        <li><div class="icon"><img src="{{ asset('assets/img/icon/bed.svg') }}" alt="icon"></div> Bed {{ property.bedrooms }}</li>
                                        <li><div class="icon"><img src="{{ asset('assets/img/icon/bath.svg') }}" alt="icon"></div> Bath {{ property.bathrooms }}</li>
                                        <li><div class="icon"><img src="{{ asset('assets/img/icon/sqft.svg') }}" alt="icon"></div> {{ property.area }} sqft</li>
                                    </ul>
                                </div>

                                <p class="mb-30 fadeinup wow">{{ property.description|nl2br }}</p>

                                <!-- Property Highlights (only real data) -->
                                <div class="hightlighes-title-wrap mb-25 fadeinup wow">
                                    <h2 class="page-title mb-2">Property Highlights</h2>
                                </div>

                                <ul class="property-grid-list fadeinup wow">
                                    <li>
                                        <div class="property-grid-list-icon"><img src="{{ asset('assets/img/icon/property-single-icon1-1.svg') }}" alt=""></div>
                                        <div class="property-grid-list-details"><h4>ID NO.</h4><p>#{{ property.id }}</p></div>
                                    </li>
                                    <li>
                                        <div class="property-grid-list-icon"><img src="{{ asset('assets/img/icon/property-single-icon1-4.svg') }}" alt=""></div>
                                        <div class="property-grid-list-details"><h4>Bedrooms</h4><p>{{ property.bedrooms }}</p></div>
                                    </li>
                                    <li>
                                        <div class="property-grid-list-icon"><img src="{{ asset('assets/img/icon/property-single-icon1-5.svg') }}" alt=""></div>
                                        <div class="property-grid-list-details"><h4>Bathrooms</h4><p>{{ property.bathrooms }}</p></div>
                                    </li>
                                    <li>
                                        <div class="property-grid-list-icon"><img src="{{ asset('assets/img/icon/property-single-icon1-6.svg') }}" alt=""></div>
                                        <div class="property-grid-list-details"><h4>Area</h4><p>{{ property.area }} sqft</p></div>
                                    </li>
                                </ul>

                                <!-- Gallery (first 6 photos) -->
                                {% if property.photos|length > 0 %}
                                    <h3 class="page-title mt-50 mb-30 fadeinup wow">Photo Gallery</h3>
                                    <div class="row gy-4 fadeinup wow">
                                        {% for photo in property.photos|slice(0, 6) %}
                                            <div class="col-xl-{{ loop.index <= 2 ? '7' : '5' }}">
                                                <div class="property-gallery-card">
                                                    <div class="property-gallery-card-img">
                                                        <img class="w-100" src="{{ asset('uploads/properties/' ~ photo) }}" alt="Gallery">
                                                    </div>
                                                    <a class="icon-btn popup-image" href="{{ asset('uploads/properties/' ~ photo) }}">
                                                        View
                                                    </a>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}

                            </div>
                        </div>
                    </div>
                </div>

                <!-- ==================== SIDEBAR ==================== -->
                <div class="col-xxl-4 col-lg-5">
{# templates/property/_sidebar.html.twig #}
<div class="sidebar-area">
    <!-- Reservation Form -->
    <div class="widget widget_contact">
        <h3 class="widget_title">Make a Reservation</h3>
        <form method="post" action="{{ path('app_property_show', { id: property.id }) }}" class="contact-form">
            <div class="form-group">
                <label>Check-in</label>
                <input type="date" name="check_in" class="form-control" required>
            </div>
            <div class="form-group">
                <label>Check-out</label>
                <input type="date" name="check_out" class="form-control" required>
            </div>
            <button type="submit" class="th-btn w-100">Send Request</button>
        </form>
    </div>

    <!-- Owner Info -->
    <div class="widget">
        <h3 class="widget_title">Owner</h3>
        <div class="media">
            <div class="media-img">
                <img src="{{ asset('assets/img/avatar.jpg') }}" alt="Owner" class="rounded-circle" width="60">
            </div>
            <div class="media-body ms-3">
                <h5 class="mb-0">{{ property.owner.firstName }} {{ property.owner.lastName }}</h5>
                <p class="text-muted mb-0">@{{ property.owner.email|split('@')[0] }}</p>
            </div>
        </div>
    </div>

    <!-- Contact Info -->
    <div class="widget widget_contact_info">
        <h3 class="widget_title">Contact Info</h3>
        <ul class="contact-info-list">
            <li><i class="fas fa-phone"></i> +216 12 345 678</li>
            <li><i class="fas fa-envelope"></i> contact@OneLoc.tn</li>
            <li><i class="fas fa-map-marker-alt"></i> Tunis, Tunisia</li>
        </ul>
    </div>
</div>                </div>

            </div>
        </div>
    </section>
{% endblock %}