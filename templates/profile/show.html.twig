{# templates/profile/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}My Profile - OneLoc Real Estate{% endblock %}

{% block body %}
<!-- Hero Profile Section -->
<div class="position-relative bg-dark overflow-hidden">
    <!-- Background Pattern -->
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(255, 65, 54, 0.1) 0%, rgba(0, 0, 0, 0.9) 100%); z-index: 1;"></div>
    
    <div class="container position-relative py-5" style="z-index: 2;">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-white-50 text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Profile</li>
                    </ol>
                </nav>
                
                <h1 class="display-4 fw-bold text-white mb-3">Welcome Back, {{ app.user.firstName }}! 👋</h1>
                <p class="lead text-white-50 mb-4">Manage your account, properties, and security settings in one place.</p>
                
                <div class="d-flex flex-wrap gap-3">

                    <div class="bg-white bg-opacity-10 rounded-pill px-4 py-2">
                        <small class="text-white-50">Properties</small>
                        <div class="text-white fw-semibold">{{ app.user.properties|length }} listed</div>
                    </div>

                </div>
            </div>
          
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="container-fluid py-5 bg-light">
    <div class="container">
        <div class="row g-4">
            <!-- Left Sidebar - Quick Actions -->
            <div class="col-lg-3">
                <div class="card shadow-sm border-0 rounded-4 sticky-top" style="top: 100px;">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark mb-3">Quick Actions</h6>
                        <div class="d-grid gap-2">
                            
                            <a href="{{ path('app_profile_edit') }}" class="btn btn-outline-dark rounded-3 py-3 fw-semibold">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                Edit Profile
                            </a>
                        </div>

                        <hr class="my-4">

                        <h6 class="fw-bold text-dark mb-3">Account Health</h6>
                        <div class="space-y-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Profile Complete</span>
                                <span class="fw-semibold text-success">100%</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Email Verified</span>
                                <span class="fw-semibold {{ app.user.verified ? 'text-success' : 'text-warning' }}">
                                    {{ app.user.verified ? 'Yes' : 'No' }}
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">2FA Enabled</span>
                                <span class="fw-semibold text-success">Yes</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-9">
                <!-- Flash Messages -->
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
                        <div class="d-flex align-items-center">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-success me-2">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                            </svg>
                            <span class="fw-semibold">{{ message }}</span>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

                <!-- Profile Overview Card -->
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white py-4 border-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-dark mb-0">Profile Overview</h5>
                            <a href="{{ path('app_profile_edit') }}" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                Edit
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="d-flex align-items-start p-3 bg-light rounded-3">
                                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="#FF4136">
                                            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Email Address</small>
                                        <span class="fw-semibold text-dark">{{ app.user.email }}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="d-flex align-items-start p-3 bg-light rounded-3">
                                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="#28a745">
                                            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Phone Number</small>
                                        <span class="fw-semibold text-dark">{{ app.user.phone|default('Not provided') }}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="d-flex align-items-start p-3 bg-light rounded-3">
                                    <div class="bg-info bg-opacity-10 rounded-circle p-3 me-3">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="#17a2b8">
                                            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Account Status</small>
                                        <span class="badge bg-{{ app.user.verified ? 'success' : 'warning' }} rounded-pill px-3 py-2">
                                            {{ app.user.verified ? 'Verified' : 'Pending Verification' }}
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="d-flex align-items-start p-3 bg-light rounded-3">
                                    <div class="bg-danger bg-opacity-10 rounded-circle p-3 me-3">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="#dc3545">
                                            <path d="M3 13h1v7c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-7h1c.55 0 1-.45 1-1s-.45-1-1-1h-1V4c0-1.1-.9-2-2-2H6C4.9 2 4 2.9 4 4v7H3c-.55 0-1 .45-1 1s.45 1 1 1zM6 4h12v7H6V4z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Properties Listed</small>
                                        <span class="fw-semibold text-dark">{{ app.user.properties|length }} active</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Security & Features Section -->
                <div class="row g-4">
                    <!-- Face Recognition Card -->
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 rounded-4 h-100">
                            <div class="card-header bg-white py-4 border-0">
                                <h6 class="fw-bold text-dark mb-0">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-primary me-2">
                                        <path d="M9 11.75c-.69 0-1.25.56-1.25 1.25s.56 1.25 1.25 1.25 1.25-.56 1.25-1.25-.56-1.25-1.25-1.25zm6 0c-.69 0-1.25.56-1.25 1.25s.56 1.25 1.25 1.25 1.25-.56 1.25-1.25-.56-1.25-1.25-1.25zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-.29.02-.58.05-.86 2.36-1.05 4.23-2.98 5.21-5.37C11.07 8.33 14.05 10 17.42 10c.78 0 1.53-.09 2.25-.26.21.71.33 1.47.33 2.26 0 4.41-3.59 8-8 8z"/>
                                    </svg>
                                    Face Recognition Login
                                </h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="text-center mb-4">
                                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3">
                                        <svg width="40" height="40" viewBox="0 0 24 24" fill="#FF4136">
                                            <path d="M9 11.75c-.69 0-1.25.56-1.25 1.25s.56 1.25 1.25 1.25 1.25-.56 1.25-1.25-.56-1.25-1.25-1.25zm6 0c-.69 0-1.25.56-1.25 1.25s.56 1.25 1.25 1.25 1.25-.56 1.25-1.25-.56-1.25-1.25-1.25zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-.29.02-.58.05-.86 2.36-1.05 4.23-2.98 5.21-5.37C11.07 8.33 14.05 10 17.42 10c.78 0 1.53-.09 2.25-.26.21.71.33 1.47.33 2.26 0 4.41-3.59 8-8 8z"/>
                                        </svg>
                                    </div>
                                    <h6 class="fw-bold text-dark">Biometric Authentication</h6>
                                    <p class="text-muted small mb-3">
                                        Enable secure, passwordless login using facial recognition technology.
                                    </p>
                                </div>
                                <a href="{{ path('app_profile_face_recognition') }}" 
                                   class="btn btn-outline-primary w-100 rounded-3 py-3 fw-semibold">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                                    </svg>
                                    {{ app.user.faceId ? 'Manage Face ID' : 'Enable Face Login' }}
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Security Status Card -->
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 rounded-4 h-100">
                            <div class="card-header bg-white py-4 border-0">
                                <h6 class="fw-bold text-dark mb-0">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-success me-2">
                                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                                    </svg>
                                    Security Status
                                </h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="space-y-3">
                                    <div class="d-flex justify-content-between align-items-center p-2">
                                        <span class="text-muted">Two-Factor Auth</span>
                                        <span class="badge bg-success rounded-pill">Active</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center p-2">
                                        <span class="text-muted">Last Login</span>
                                        <span class="fw-semibold text-dark">2 hours ago</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center p-2">
                                        <span class="text-muted">Device</span>
                                        <span class="fw-semibold text-dark">Chrome, MacOS</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center p-2">
                                        <span class="text-muted">Account Protection</span>
                                        <span class="badge bg-success rounded-pill">Maximum</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .avatar-xxl {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #FF4136 0%, #d63028 100%);
    }
    
    .bg-gradient-primary {
        background: linear-gradient(135deg, #FF4136 0%, #d63028 100%) !important;
    }
    
    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .card:hover {
        tr  nsform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
    }
    
    .sticky-top {
        position: sticky;
        z-index: 10;
    }
    
    .breadcrumb {
        background: transparent;
    }
    
    .bg-opacity-10 {
        background-color: rgba(var(--bs-primary-rgb), 0.1) !important;
    }
</style>
{% endblock %}