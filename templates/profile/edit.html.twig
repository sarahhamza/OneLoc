{# templates/profile/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Edit Profile - OneLoc Real Estate{% endblock %}

{% block body %}
<!-- Hero Section -->
<div class="position-relative bg-dark overflow-hidden">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(255, 65, 54, 0.1) 0%, rgba(0, 0, 0, 0.9) 100%); z-index: 1;"></div>
    
    <div class="container position-relative py-4" style="z-index: 2;">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-white-50 text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('app_profile_show') }}" class="text-white-50 text-decoration-none">Profile</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Edit Profile</li>
                    </ol>
                </nav>
                
                <h1 class="display-5 fw-bold text-white mb-2">Edit Your Profile</h1>
                <p class="lead text-white-50">Update your personal information and account settings</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a href="{{ path('app_profile_show') }}" class="btn btn-outline-light btn-lg rounded-pill px-4">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                        <path d="M19 12H5M5 12L12 19M5 12L12 5"/>
                    </svg>
                    Back to Profile
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Edit Form Section -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-lg border-0 rounded-4">


                <div class="card-body p-5">
                    <form method="post" novalidate class="needs-validation" id="profileForm">
                        <div class="row g-4">
                            <!-- Personal Information Section -->
                            <div class="col-12">
                                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-primary me-2">
                                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                    </svg>
                                    Personal Information
                                </h6>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">
                                    First Name <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0 rounded-3 rounded-end-0">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-muted">
                                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                        </svg>
                                    </span>
                                    <input type="text" name="firstName" class="form-control border-0 bg-light rounded-3 rounded-start-0 py-3" 
                                           value="{{ user.firstName }}" required placeholder="Enter your first name">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">
                                    Last Name <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0 rounded-3 rounded-end-0">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-muted">
                                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                        </svg>
                                    </span>
                                    <input type="text" name="lastName" class="form-control border-0 bg-light rounded-3 rounded-start-0 py-3" 
                                           value="{{ user.lastName }}" required placeholder="Enter your last name">
                                </div>
                            </div>

                            <!-- Contact Information Section -->
                            <div class="col-12 mt-4">
                                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-success me-2">
                                        <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                                    </svg>
                                    Contact Information
                                </h6>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark">Email Address</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0 rounded-3 rounded-end-0">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-muted">
                                            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                                        </svg>
                                    </span>
                                    <input type="email" class="form-control border-0 bg-light rounded-3 rounded-start-0 py-3" 
                                           value="{{ user.email }}" disabled placeholder="Your email address">
                                </div>
                                <small class="text-muted mt-2">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-warning me-1">
                                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                                    </svg>
                                    Email address cannot be changed for security reasons.
                                </small>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark">Phone Number</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0 rounded-3 rounded-end-0">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-muted">
                                            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                                        </svg>
                                    </span>
                                    <input type="text" name="phone" class="form-control border-0 bg-light rounded-3 rounded-start-0 py-3" 
                                           value="{{ user.phone }}" placeholder="+1 (555) 123-4567">
                                </div>
                                <small class="text-muted mt-2">We'll use this for important notifications and verification.</small>
                            </div>

                            <!-- Security Section -->
                            <div class="col-12 mt-4">
                                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-danger me-2">
                                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM12 17c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm6-9H6V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2h2V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2z"/>
                                    </svg>
                                    Security Settings
                                </h6>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark">New Password</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-0 rounded-3 rounded-end-0">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-muted">
                                            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM12 17c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm6-9H6V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2h2V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2z"/>
                                        </svg>
                                    </span>
                                    <input type="password" name="password" class="form-control border-0 bg-light rounded-3 rounded-start-0 py-3" 
                                           placeholder="Leave blank to keep current password" id="passwordField">
                                    <button type="button" class="btn bg-light border-0 rounded-3 rounded-start-0" onclick="togglePassword()">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-muted" id="passwordToggle">
                                            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                        </svg>
                                    </button>
                                </div>
                                <div class="password-strength mt-2">
                                    <div class="progress" style="height: 4px;">
                                        <div class="progress-bar" id="passwordStrength" style="width: 0%; background: #e9ecef;"></div>
                                    </div>
                                    <small class="text-muted" id="passwordHint">Enter a new password to check strength</small>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="col-12 text-center mt-5 pt-3 border-top">
                                <button type="submit" class="btn btn-success btn-lg px-5 py-3 rounded-pill fw-bold me-3">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                                        <path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/>
                                    </svg>
                                    Save Changes
                                </button>
                                <a href="{{ path('app_profile_show') }}" class="btn btn-outline-dark btn-lg px-5 py-3 rounded-pill fw-semibold">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                                        <path d="M19 12H5M5 12L12 19M5 12L12 5"/>
                                    </svg>
                                    Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Security Tips -->
            <div class="card border-0 rounded-4 shadow-sm mt-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-info me-2">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                        </svg>
                        Security Tips
                    </h6>
                    <ul class="list-unstyled text-muted space-y-2">
                        <li class="d-flex align-items-start">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-success me-2 mt-1 flex-shrink-0">
                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                            </svg>
                            <span>Use a strong, unique password that you don't use elsewhere</span>
                        </li>
                        <li class="d-flex align-items-start">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-success me-2 mt-1 flex-shrink-0">
                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                            </svg>
                            <span>Enable two-factor authentication for extra security</span>
                        </li>
                        <li class="d-flex align-items-start">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-success me-2 mt-1 flex-shrink-0">
                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                            </svg>
                            <span>Keep your phone number updated for important notifications</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #FF4136 0%, #d63028 100%) !important;
    }
    
    .avatar-lg {
        width: 80px;
        height: 80px;
    }
    
    .form-control:focus {
        box-shadow: 0 0 0 0.2rem rgba(255, 65, 54, 0.25);
        border-color: #FF4136;
    }
    
    .input-group-text {
        transition: all 0.3s ease;
    }
    
    .input-group:focus-within .input-group-text {
        background-color: rgba(255, 65, 54, 0.1);
        color: #FF4136;
    }
    
    .card {
        transition: transform 0.2s ease;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
    
    .password-strength .progress {
        background: #f8f9fa;
        border-radius: 2px;
    }
</style>

<script>
    function togglePassword() {
        const passwordField = document.getElementById('passwordField');
        const passwordToggle = document.getElementById('passwordToggle');
        
        if (passwordField.type === 'password') {
            passwordField.type = 'text';
            passwordToggle.innerHTML = '<path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>';
        } else {
            passwordField.type = 'password';
            passwordToggle.innerHTML = '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>';
        }
    }
    
    // Password strength indicator
    document.getElementById('passwordField').addEventListener('input', function(e) {
        const password = e.target.value;
        const strengthBar = document.getElementById('passwordStrength');
        const strengthHint = document.getElementById('passwordHint');
        
        if (password.length === 0) {
            strengthBar.style.width = '0%';
            strengthBar.style.background = '#e9ecef';
            strengthHint.textContent = 'Enter a new password to check strength';
            strengthHint.className = 'text-muted';
            return;
        }
        
        let strength = 0;
        let hints = [];
        
        // Length check
        if (password.length >= 8) strength += 25;
        if (password.length >= 12) strength += 15;
        
        // Complexity checks
        if (/[a-z]/.test(password)) strength += 15;
        if (/[A-Z]/.test(password)) strength += 15;
        if (/[0-9]/.test(password)) strength += 15;
        if (/[^a-zA-Z0-9]/.test(password)) strength += 15;
        
        // Update progress bar
        strengthBar.style.width = strength + '%';
        
        // Update colors and hints
        if (strength < 40) {
            strengthBar.style.background = '#dc3545';
            strengthHint.textContent = 'Weak password - try adding more characters and types';
            strengthHint.className = 'text-danger';
        } else if (strength < 70) {
            strengthBar.style.background = '#ffc107';
            strengthHint.textContent = 'Moderate password - could be stronger';
            strengthHint.className = 'text-warning';
        } else {
            strengthBar.style.background = '#28a745';
            strengthHint.textContent = 'Strong password - good job!';
            strengthHint.className = 'text-success';
        }
    });
    
    // Form validation
    document.getElementById('profileForm').addEventListener('submit', function(e) {
        const firstName = document.querySelector('input[name="firstName"]');
        const lastName = document.querySelector('input[name="lastName"]');
        
        if (!firstName.value.trim() || !lastName.value.trim()) {
            e.preventDefault();
            alert('Please fill in all required fields');
            return;
        }
    });
</script>
{% endblock %}