{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h2 class="text-center mb-4">Sign In</h2>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post">
                    <div class="mb-3">
                        <label>Email</label>
                        <input type="email" name="email" class="form-control" value="{{ last_username }}" required>
                    </div>

                    <div class="mb-3">
                        <label>Password</label>
                        <input type="password" name="password" class="form-control" required>
                    </div>

                    <div class="text-end mb-3">
                        <a href="{{ path('app_forgot_password') }}">Forgot password?</a>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button class="btn btn-primary w-100">Login</button>
                    <div class="text-center mt-3">
                        <button type="button" id="face-login-btn" class="btn btn-dark w-100">
                            Login with Face ID
                        </button>
                        <div id="face-status" class="mt-2 small text-muted"></div>
                    </div>
                </form>

                <p class="text-center mt-3">
                    <a href="{{ path('app_register') }}">Create an account</a>
                </p>
            </div>
        </div>
    </div>
{% endblock %}
{% block javascripts %}
    <script>
        document.getElementById('face-login-btn').addEventListener('click', async function () {
            const statusEl = document.getElementById('face-status');
            statusEl.textContent = 'Opening camera... Please look at the camera and press "s" when ready.';

            try {
                const response = await fetch('http://localhost:5000/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await response.json();

                if (data.status === 'success' && data.uuid) {
                    // Send UUID to Symfony backend to log the user in
                    const symfonyResponse = await fetch('{{ path('app_face_login') }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': '{{ csrf_token('face_login') }}'
                        },
                        body: JSON.stringify({ face_uuid: data.uuid })
                    });

                    const result = await symfonyResponse.json();

                    if (result.success) {
                        statusEl.innerHTML = '<span class="text-success">Face recognized! Logging you in...</span>';
                        setTimeout(() => window.location.href = result.redirect, 1000);
                    } else {
                        statusEl.innerHTML = `<span class="text-danger">${result.message || 'Access denied'}</span>`;
                    }
                } else {
                    statusEl.innerHTML = '<span class="text-danger">Face not recognized or not registered.</span>';
                }
            } catch (err) {
                console.error(err);
                statusEl.innerHTML = '<span class="text-danger">Error connecting to face recognition service.</span>';
            }
        });
    </script>

{% endblock %}
